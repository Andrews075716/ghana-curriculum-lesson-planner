# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/ghana_curriculum_planner?schema=public"

# development | test | production
NODE_ENV="development"

# AI provider abstraction (server/ai). "none" (default) resolves to
# NoopAIProvider — AI-assisted suggestions are defined but disabled.
# "anthropic" resolves to AnthropicAIProvider (server/ai/providers/anthropic-ai-provider.ts),
# which requires ANTHROPIC_API_KEY below. This key is read server-side only
# (see the `server-only` import in that file) and is never sent to the browser.
AI_PROVIDER="none"

# Required when AI_PROVIDER="anthropic". Get a key at https://console.anthropic.com/ .
# NEVER commit a real key — this file only holds a placeholder.
ANTHROPIC_API_KEY=""

# Optional: overrides the default Claude model (see DEFAULT_MODEL in
# anthropic-ai-provider.ts) without a code change.
ANTHROPIC_MODEL=""

# Optional: path to a Chrome/Chromium executable, used to render the
# lesson planner "Export to PDF" feature. Only needed if the installed
# Chrome isn't found automatically (see src/server/pdf/find-chrome.ts).
PUPPETEER_EXECUTABLE_PATH=""

# Required. Signs session cookies (see src/server/auth/session.ts) and is
# read by src/proxy.ts for the optimistic route-protection check. Generate
# with `openssl rand -base64 32`. NEVER commit a real value — rotating it
# invalidates every existing session.
SESSION_SECRET=""

# Email provider abstraction (server/email). "console" (default) logs
# password-reset emails to the server log instead of sending them — see
# server/email/providers/console-email-provider.ts. No real provider is
# implemented yet; this is reserved for one.
EMAIL_PROVIDER="console"
